data/

# ---------------------------------------------------------------------------
# 本地私有内容：上游原版备份、运行日志、截图
# ---------------------------------------------------------------------------
_private/
logs/
*.log
*.log.err
shot.png

# ---------------------------------------------------------------------------
# 美术素材：上游 PROVENANCE 声明这些不在 MIT 范围内、不授予再许可，
# 所以本仓库不分发。需要的话跑 `node scripts/fetch-assets.mjs` 从官方源取。
# （只排除素材，assets/whale-widget.js 是代码，要发布）
# ---------------------------------------------------------------------------
vendor/dsh-whale-widget/assets/*.png
vendor/dsh-whale-widget/assets/*.gif
vendor/dsh-whale-widget/assets/*.mp3
vendor/dsh-whale-widget/assets/*.wav

